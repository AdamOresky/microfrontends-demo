    "02_iframe": "concurrently --names \"home,product,cart,storage\" \"serve --listen 3001 02_iframe/team-home\" \"serve --listen 3002 02_iframe/team-product\" \"serve --listen 3003 02_iframe/team-cart\" \"npm:storage\" \"npx wait-on http-get://localhost:3002/home && opener http://localhost:3002/home\"",
    "03_ajax": "concurrently --names \"home,product,cart,storage\" \"serve --cors --listen 3001 03_ajax/team-home\" \"serve --cors --listen 3002 03_ajax/team-product\" \"serve --cors --listen 3003 03_ajax/team-cart\" \"npm:storage\" \"npx wait-on http-get://localhost:3002/home && opener http://localhost:3002/home\"",
    "04_web_components": "concurrently --names \"home,product,cart,storage\" \"serve --cors --listen 3001 04_web_components/team-home\" \"serve --cors --listen 3002 04_web_components/team-product\" \"serve --cors --listen 3003 04_web_components/team-cart\" \"npm:storage\" \"npx wait-on http-get://localhost:3001/home && opener http://localhost:3001/home\""
